{
  "name": "billocr-intake",
  "version": "0.3.0",
  "description": "BillOCR Intake - runs the CMS-1500/UB-04 extraction watcher on the dedicated OCR machine",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "postversion": "node scripts/postversion.js"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.anabaptistbrotherhood.billocr-intake",
    "productName": "BillOCR Intake",
    "files": [
      "main.js",
      "preload.js",
      "updateProvider.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../pipeline",
        "to": "pipeline",
        "filter": [
          "common.py",
          "claim_schemas.py",
          "field_validation.py",
          "extract_claim_fields.py",
          "dump_schema.py",
          "requirements.txt"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "BillOCR",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.2",
    "semver": "^7.8.5"
  }
}
