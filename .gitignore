# OS cruft
.DS_Store

# Node / Electron
node_modules/
dist/
*.log
npm-debug.log*

# Frozen, platform-specific PyInstaller build of Review's pipeline CLI --
# built fresh per platform by scripts/build-pipeline-cli.js (locally) or
# release-review.yml (CI), never committed. See review-app/main.js's
# PIPELINE_CLI_PATH comment.
review-app/vendor/

# Copied fresh from renderer/{styles,app}.css before every viewer build --
# see review-app/viewer/scripts/sync-shared-styles.mjs.
review-app/viewer/src/shared/

# Python
__pycache__/
*.pyc

# Any local workspace folder someone points an app at from inside this repo
# by mistake (it shouldn't be -- see README's "workspace folder" section --
# but this is a safety net so real claim data / PHI never lands in git).
/workspace/
/*.workspace/
org_config.json
control_numbers.json
incoming_1500/
incoming_ub04/
pending_review/
approved/
output_837/
