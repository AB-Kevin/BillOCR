{
  "name": "billocr-review",
  "version": "0.2.5",
  "description": "BillOCR Review - review, edit, and approve extracted claims, building 837 files on approval",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:pipeline-cli": "node scripts/build-pipeline-cli.js",
    "build:viewer": "cd viewer && npm run build",
    "predist": "npm run build:viewer",
    "dist": "electron-builder --win --publish never",
    "predist:mac": "npm run build:pipeline-cli && npm run build:viewer",
    "dist:mac": "electron-builder --mac --publish never",
    "postversion": "node scripts/postversion.js"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.anabaptistbrotherhood.billocr-review",
    "productName": "BillOCR Review",
    "files": [
      "main.js",
      "preload.js",
      "updateProvider.js",
      "viewerPreload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../pipeline",
        "to": "pipeline",
        "filter": [
          "org_config.example.json"
        ]
      },
      {
        "from": "vendor/pipeline-cli",
        "to": "pipeline-cli"
      },
      {
        "from": "viewer/dist",
        "to": "viewer"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "BillOCR",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.2",
    "semver": "^7.8.5"
  }
}
